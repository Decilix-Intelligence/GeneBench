{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genebench/artifact/S5/v1.0",
  "x-gateway-fetch-contract": {
    "note": "取数约定（两臂共享）。这不是产物 schema 的一部分，是**发请求**的约定。",
    "bounded_window": "每一次取数都必须把区间**界定在 as_of 之内**：显式给 `start_date` 与 `end_date`（或单日 `date`），且 `end_date <= as_of`。开区间（不给右端）会被网关拒（`open_range_would_cross_asof`）—— 它拒的是「没界定」，不是「你要了未来」。",
    "gated_vs_telemetry": "显式越界（`end_date` 超过 as_of、目标日期在 as_of 之后、越过冻结线…）→ `lookahead` 违例 → 闸门；开区间 → **只计数**，进 Table A 的 `unbounded_requests` 列，不影响判定。"
  },
  "title": "GeneBench S5 artifact v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "stage",
    "task_id",
    "config_id",
    "arm",
    "seed",
    "as_of",
    "produced_at",
    "provenance",
    "declarations",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "S5"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "produced_at": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "artifact_id"
        ],
        "properties": {
          "stage": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4",
              "S5",
              "S6",
              "S7",
              "S8"
            ]
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "declarations": {
      "type": "object",
      "required": [
        "value_semantics",
        "signal_frequency",
        "direction",
        "universe_ref",
        "missing_policy",
        "input_factors"
      ],
      "properties": {
        "value_semantics": {
          "enum": [
            "rank",
            "score",
            "unresolved"
          ]
        },
        "signal_frequency": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "unresolved"
          ]
        },
        "direction": {
          "enum": [
            "higher_is_long",
            "lower_is_long",
            "unresolved"
          ]
        },
        "universe_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "unresolved"
            }
          ]
        },
        "missing_policy": {
          "enum": [
            "keep_null",
            "fill_zero",
            "forward_fill",
            "unresolved"
          ]
        },
        "input_factors": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "const": "unresolved"
            }
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "signals",
        "coverage"
      ],
      "properties": {
        "signals": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "date",
              "symbol",
              "value"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "x-nullable-when": "依赖的声明字段被标 unresolved（诚实终止）：['direction', 'signal_frequency', 'value_semantics']"
        },
        "coverage": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "n_valued",
            "n_null",
            "n_flat"
          ],
          "properties": {
            "n_valued": {
              "type": "integer",
              "minimum": 0
            },
            "n_null": {
              "type": "integer",
              "minimum": 0
            },
            "n_flat": {
              "type": "integer",
              "minimum": 0
            }
          },
          "x-nullable-when": "依赖的声明字段被标 unresolved（诚实终止）：['signal_frequency']"
        }
      }
    }
  },
  "x-genebench": {
    "three_state_note": "声明字段：有值 / 显式 'unresolved' / 缺失 三态；null 一律畸形。语义层（与 TaskSpec、网关日志、可交易性视图的交叉核）在 reference/artifact_schema.py::validate，JSON Schema 只管结构。"
  }
}
