  "missing_row_policy": {"keep_missing": ["keep_na", "keep_nan"], "forward_fill": ["ffill"], "drop": ["dropna"]},
  "missing_policy": {"keep_null": ["keep_na", "keep_nan"], "forward_fill": ["ffill"], "fill_zero": ["zerofill"]},
  "side": {"buy": ["B", "bid", "买入"], "sell": ["S", "ask", "卖出"]},
