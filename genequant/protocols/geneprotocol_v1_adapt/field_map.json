   "yfinance": "600000.SS（上交所后缀 .SS）/ 000001.SZ",
   "akshare": "sh600000 / sz000001（小写前缀在前，无点号）",
   "internal_legacy": "SH600000 / SZ000001（大写前缀在前，无点号）"
  },
  "rules": [
